{
  "schemaVersion": 1,
  "name": "nestdev-mesh",
  "version": "0.9.0",
  "provides": [
    {
      "type": "skills",
      "path": "skills",
      "assets": [
        {
          "from": "packages/tmux-bridge/bin",
          "into": "bin",
          "include": ["*.sh"],
          "mode": "preserve"
        },
        {
          "from": "packages/tmux-bridge/agents",
          "into": "agents",
          "include": ["*.conf"],
          "mode": "preserve"
        }
      ]
    }
  ]
}
