{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${AGENT_MESH_BIN:?}/agent-session-inbox.py\" hook --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(python3 \"${AGENT_MESH_BIN:?}/agent-session-inbox.py\" hook --agent claude) 2>/dev/null || true",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
