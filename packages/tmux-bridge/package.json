{
  "name": "@openclaw-agent-mesh/tmux-bridge",
  "version": "0.9.0",
  "private": true,
  "description": "Agnostic tmux bridge for CLI-to-CLI agent intercommunication (Codex, Claude Code, and others).",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "echo 'tmux-bridge: shell-only package, no build step'",
    "test": "scripts/socket-isolation-test.sh && scripts/smoke-test.sh && scripts/mesh-cli-smoke.sh",
    "smoke": "scripts/smoke-test.sh",
    "test:isolation": "scripts/socket-isolation-test.sh",
    "test:mesh-cli": "scripts/mesh-cli-smoke.sh",
    "postinstall": "chmod +x bin/*.sh scripts/*.sh 2>/dev/null || true"
  },
  "bin": {
    "agent-session": "./bin/agent-session.sh",
    "agent-send": "./bin/agent-send.sh",
    "agent-read": "./bin/agent-read.sh",
    "mesh-list-agents": "./bin/mesh-list-agents.sh",
    "mesh-send": "./bin/mesh-send.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
