{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plexus:ledger-view:v1",
  "title": "Plexus ledger view v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "plexus.ledger-view/v1"
    },
    "profile_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "graph_revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "groups_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "grant_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "profile_revision",
    "graph_revision",
    "groups_revision",
    "sort",
    "total",
    "count",
    "summary",
    "items",
    "errors"
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "due": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectName": {
          "type": [
            "string",
            "null"
          ]
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "leadGroupRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "priority": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "size": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "waitingOnOwner": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "thread": {
          "$ref": "#/$defs/thread"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "state",
        "status",
        "due",
        "domain",
        "project",
        "projectName",
        "assignee",
        "leadGroupRef",
        "sourceRevision",
        "updatedAt",
        "ref",
        "priority",
        "size",
        "waitingOnOwner",
        "sessions",
        "owners",
        "groups",
        "thread",
        "fields"
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "nativeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "harness",
        "nativeId",
        "title",
        "status",
        "role",
        "url"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "lead": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "ref",
        "id",
        "name",
        "role",
        "lead"
      ]
    },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chan": {
          "type": [
            "string",
            "null"
          ]
        },
        "cmsg": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "missingReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallbackReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "enum": [
            "item",
            "session",
            "director",
            "project",
            "missing"
          ]
        }
      },
      "required": [
        "chan",
        "cmsg",
        "url",
        "resolution",
        "missingReason",
        "fallbackReason"
      ]
    }
  }
}
