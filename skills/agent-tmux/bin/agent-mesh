#!/usr/bin/env python3
"""Agent Mesh local control CLI."""
import os
from pathlib import Path
import sys

commands = {'comms': 'mesh-comms.py', 'group': 'mesh-groups.py'}
if len(sys.argv) < 2 or sys.argv[1] not in commands:
    sys.exit('Usage: agent-mesh comms status|on|queue|off|sync|mcp [--scope claude|codex] [--reason TEXT --by ACTOR]\n'
             '       agent-mesh group --help')
script = Path(__file__).resolve().with_name(commands[sys.argv[1]])
os.execv(sys.executable, [sys.executable, str(script), *sys.argv[2:]])
